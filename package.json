{
  "name": "datacamp-light",
  "version": "3.0.0",
  "description": "Convert any blog or website to an interactive learning platform for data science using WebAssembly",
  "main": "dist/dcl-react.js",
  "module": "dist/dcl-react.es.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "update:shellwhat": "node scripts/update-shellwhat.js",
    "update:testwhat": "node scripts/update-testwhat.js"
  },
  "author": "DataCamp",
  "license": "GPL-3.0",
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@datacamp/waffles": "^5.39.3",
    "@datacamp/waffles-fonts": "^2.2.0",
    "@emotion/react": "^11.14.0",
    "@lezer/highlight": "^1.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "i18next": "^26.4.0",
    "pyodide": "^0.27.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^17.4.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  }
}
