CROSS_COMPILE=em
CC=emcc

SKIP_STRIP=y

EM_LDFLAGS = -s ENVIRONMENT="web,worker" \
			 -s FILESYSTEM=1 \
			 -s MODULARIZE=1 \
			 -s EXPORTED_RUNTIME_METHODS=['callMain','FS','TTY'] \
			 -s INVOKE_RUN=0 \
			 -s EXIT_RUNTIME=1 \
			 -s EXPORT_ES6=0 \
			 -s EXPORT_NAME='EmscrJSR_busybox' \
			 -s ALLOW_MEMORY_GROWTH=1

cmd_busybox__ = $(srctree)/scripts/trylink \
	"$@.js" \
	"$(CC)" \
	"$(CFLAGS) $(CFLAGS_busybox)" \
	"$(LDFLAGS) $(EM_LDFLAGS) $(EXTRA_LDFLAGS)" \
	"$(core-y)" \
	"$(libs-y)" \
	"$(LDLIBS)" \
	$(CONFIG_EXTRA_LDLIBS) \
	&& $(srctree)/scripts/generate_BUFSIZ.sh --post include/common_bufsiz.h

busybox.js: busybox_unstripped
	@cp busybox_unstripped.js busybox.js
	@sed -i "s/busybox_unstripped\.wasm/busybox.wasm/g" busybox.js

busybox.wasm: busybox_unstripped
	@cp busybox_unstripped.wasm busybox.wasm

wasm: busybox.wasm busybox.js
